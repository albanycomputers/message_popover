<?php

/**
 * @file
 * Native Popover API integration for Backdrop system messages.
 */

/**
 * Implements hook_menu().
 */
function message_popover_menu() {
  $items['admin/config/user-interface/message-popover'] = [
    'title' => 'Message Popover Settings',
    'description' => 'Configure behaviour for native popover system messages.',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['message_popover_settings_form'],
    'access arguments' => ['administer site configuration'],
    'type' => MENU_NORMAL_ITEM,
  ];
  return $items;
}

/**
 * Settings form callback.
 */
function message_popover_settings_form($form, &$form_state) {
  $config = config('message_popover.settings');
  $form['#config'] = 'message_popover.settings';

  $form['debug_mode'] = [
    '#type' => 'checkbox',
    '#title' => t('Force Debug Mode'),
    '#description' => t('If checked, all messages will use "manual" popovers.'),
    '#default_value' => $config->get('debug_mode'),
  ];

  $form['persistence_limit'] = [
    '#type' => 'number',
    '#title' => t('Auto-Persistence Character Limit'),
    '#description' => t('Messages longer than this will stay open automatically. Set to 0 to disable.'),
    // ?? not ?: — a saved 0 must redisplay as 0, not the default.
    '#default_value' => $config->get('persistence_limit') ?? 300,
  ];

  $form['dismiss_timer'] = [
    '#type' => 'number',
    '#title' => t('Auto-Dismiss Timer (ms)'),
    '#description' => t('How long standard messages remain visible. Set to 0 to disable auto-dismiss (all messages stay until closed).'),
    '#default_value' => $config->get('dismiss_timer') ?? 8000,
  ];

  return system_settings_form($form);
}

/**
 * Implements hook_theme_registry_alter().
 */
function message_popover_theme_registry_alter(&$theme_registry) {
  if (isset($theme_registry['status_messages'])) {
    $theme_registry['status_messages']['function'] = 'theme_message_popover_display';
  }
}

/**
 * Primary theme callback for system messages.
 */
function theme_message_popover_display($variables) {
  $display = $variables['display'];
  $all_messages = backdrop_get_messages($display);

  if (empty($all_messages)) {
    return '';
  }

  $config = config('message_popover.settings');
  // ?? not ?: — a configured 0 (disable) must survive; ?: would coerce it to the default.
  $dismiss_timer = $config->get('dismiss_timer') ?? 8000;
  $persistence_limit = $config->get('persistence_limit') ?? 300;

  backdrop_add_js([
    'messagePopover' => ['timer' => (int) $dismiss_timer]
  ], 'setting');

  $path = backdrop_get_path('module', 'message_popover');
  backdrop_add_css($path . '/css/message_popover.css');
  // Icon URLs are resolved server-side via base_path() so they work at any
  // install depth AND in subdirectory installs; the stylesheet consumes these
  // custom properties instead of hardcoding paths.
  $icon_base = base_path() . 'core/misc/icons/';
  backdrop_add_css(
    ':root {'
    . ' --message-popover-icon-status: url(' . $icon_base . 'check-circle.svg);'
    . ' --message-popover-icon-warning: url(' . $icon_base . 'exclamation-triangle.svg);'
    . ' --message-popover-icon-error: url(' . $icon_base . 'exclamation-circle.svg);'
    . ' }',
    ['type' => 'inline']
  );
  backdrop_add_js($path . '/js/message_popover.js');

  $rendered_items = '';

  foreach ($all_messages as $type => $messages) {
    foreach ($messages as $index => $message) {

      $plain_text = trim(strip_tags($message));

      // Skip Devel "..." ghost messages (bare ellipsis with no debug payload).
      if ($plain_text === '...' && !str_contains($message, '<table') && !str_contains($message, '<div')) {
        continue;
      }
      // Skip messages with no displayable content. Markup-only messages are
      // kept ONLY when they contain an element that renders something visible
      // by itself (image, media, table, form control) — empty wrappers like
      // Devel's <pre></pre> from an Execute PHP run with no printed output
      // strip to nothing and are noise.
      if ($plain_text === ''
        && !preg_match('/<(img|svg|picture|table|iframe|video|audio|canvas|object|embed|input|button|select|textarea|progress|hr)\b/i', $message)) {
        continue;
      }

      // Detection for persistence behaviour. backdrop_strlen counts characters,
      // not bytes, so multibyte text is measured correctly.
      $is_long = ($persistence_limit > 0 && backdrop_strlen($plain_text) > $persistence_limit);
      $is_debug = str_contains($message, 'krumo') || str_contains($message, '<pre') || str_contains($message, '<table');

      $auto_dismiss = !($config->get('debug_mode') || $type === 'error' || $is_long || $is_debug);

      // Always popover="manual": per the Popover API spec, non-nested "auto"
      // popovers light-dismiss each other, so a batch of messages would
      // collapse to just the last one. Auto-dismissal is the JS timer's job.
      // The uniqid suffix keeps IDs unique across HTMX swaps in one page
      // session — backdrop_html_id() only deduplicates within a request.
      $id = backdrop_html_id('msg-' . $type . '-' . $index . '-' . substr(uniqid(), -6));
      $attributes = [
        'id' => $id,
        'popover' => 'manual',
        'role' => ($type === 'error') ? 'alert' : 'status',
        'data-auto-dismiss' => $auto_dismiss ? 'true' : 'false',
        'class' => ['messages', $type, 'message-popover-item'],
      ];

      $type_labels = [
        'status' => t('Status message'),
        'warning' => t('Warning message'),
        'error' => t('Error message'),
        'info' => t('Info message'),
      ];
      $type_label = isset($type_labels[$type]) ? $type_labels[$type] : t('Message');

      $rendered_items .= '<div ' . backdrop_attributes($attributes) . '>';
      $rendered_items .= '  <div class="message-popover-icon"></div>';
      // Hidden severity label gives screen readers the message type; the span
      // allows specific vertical alignment via CSS.
      $rendered_items .= '  <div class="message-content"><span class="element-invisible">' . $type_label . ': </span><span class="popover-message-text">' . $message . '</span></div>';
      $rendered_items .= '  <button class="popover-close" popovertarget="' . $id . '" popovertargetaction="hide" aria-label="' . t('Close') . '">&times;</button>';
      $rendered_items .= '</div>';
    }
  }

  return $rendered_items;
}

/**
 * Implements hook_preprocess_layout().
 */
function message_popover_preprocess_layout(&$variables) {
  if (isset($_SERVER['HTTP_HX_REQUEST']) && $_SERVER['HTTP_HX_REQUEST'] === 'true') {
    $messages = theme('status_messages');
    if ($messages) {
      $variables['content'] .= '<div id="messages-container-oob" hx-swap-oob="afterbegin">' . $messages . '</div>';
    }
  }
}

/**
 * Implements hook_page_bottom().
 */
function message_popover_page_bottom(&$page_bottom) {
  $page_bottom['message_popover_container'] = [
    '#markup' => '<div id="messages-container-oob" style="display:none;"></div>',
  ];
}